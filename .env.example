# Copie para `.env.local` e ajuste. Nunca versione o arquivo preenchido.

# URL pública do portal — usada em metadados, sitemap.xml e robots.txt
NEXT_PUBLIC_SITE_URL=https://www.mepb.org.br

# ---------------------------------------------------------------------------
# CMS (apenas quando a migração descrita em docs/03-modelo-de-conteudo.md
# for feita — o protótipo funciona sem estas variáveis)
# ---------------------------------------------------------------------------
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=

# ---------------------------------------------------------------------------
# Banco de dados (consumido pelo docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_DB=mepb
POSTGRES_USER=mepb
POSTGRES_PASSWORD=mepb_dev

# ---------------------------------------------------------------------------
# Segredos do Strapi — gerar valores próprios em produção
# ---------------------------------------------------------------------------
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
